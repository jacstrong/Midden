{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": false,
    "replicas": false,
    "autoscaling": false,
    "publicOrigin": {
      "type": "string",
      "pattern": "^($|https?://[^/]+$)"
    },
    "trustProxy": {
      "type": ["boolean", "null"]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "accessMode": {
          "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"]
        },
        "keepOnUninstall": {
          "type": "boolean"
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^($|sha256:[0-9a-f]{64}$)"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  },
  "description": "Midden runs as exactly one pod, so there is no replica count or autoscaling. See docs/kubernetes.md."
}
