{
  "name": "@midden/web",
  "version": "0.1.0",
  "private": true,
  "description": "Midden web client (hosted bundle and standalone single-file build)",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:worker && vite",
    "build:worker": "vite build --config vite.worker.config.ts",
    "build": "pnpm build:worker && vite build",
    "build:standalone": "pnpm build:worker && vite build --config vite.standalone.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@midden/core": "workspace:*",
    "@tanstack/react-virtual": "^3.14.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
