{
  "name": "@midden/core",
  "version": "0.1.0",
  "private": true,
  "description": "Midden shared domain: types, ops, reducer, codecs, nmap parsing, layouts, command builder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "saxes": "^6.0.0",
    "zod": "^4.6.5"
  },
  "sideEffects": false
}
