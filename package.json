{
  "name": "midden",
  "version": "0.1.0",
  "private": true,
  "description": "Cyber hunt / DCO attack reconstruction and terrain mapping",
  "type": "module",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm seed:dev --if-missing && pnpm -r --parallel --filter './packages/**' dev",
    "dev:server": "pnpm seed:dev --if-missing && pnpm --filter @midden/server dev",
    "dev:web": "pnpm --filter @midden/web dev",
    "dev:standalone": "pnpm --filter @midden/web dev:standalone",
    "dev:reset": "pnpm seed:dev --reset",
    "seed:dev": "pnpm --filter @midden/core build && node --no-warnings --experimental-transform-types --import ./scripts/dev-ts.mjs scripts/seed-dev.ts",
    "build": "pnpm -r --filter './packages/**' build",
    "build:standalone": "pnpm --filter @midden/web build:standalone",
    "start": "MIDDEN_DATA=\"${MIDDEN_DATA:-$PWD/data/dev}\" MIDDEN_PUBLIC_DIR=\"${MIDDEN_PUBLIC_DIR:-$PWD/packages/web/dist}\" pnpm --filter @midden/server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @midden/core build && pnpm -r typecheck",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest",
    "e2e": "pnpm --filter @midden/e2e test",
    "e2e:hosted": "pnpm build && pnpm --filter @midden/e2e exec playwright test --project=hosted --project=hosted-webkit",
    "e2e:standalone": "pnpm build:standalone && pnpm --filter @midden/e2e test:standalone",
    "e2e:install": "pnpm --filter @midden/e2e install-browsers",
    "load": "pnpm build && pnpm --filter @midden/server load",
    "ci": "bash scripts/ci-test.sh",
    "check:native": "scripts/check-no-native.sh",
    "check:nmap": "node --no-warnings=ExperimentalWarning scripts/check-nmap-commands.ts",
    "docs:api": "node --no-warnings --experimental-transform-types --import ./scripts/dev-ts.mjs scripts/gen-api-docs.ts",
    "site:dev": "pnpm --filter @midden/website dev",
    "site:build": "pnpm --filter @midden/website build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@midden/core": "workspace:*",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.1",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
